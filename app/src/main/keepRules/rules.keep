# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Gson constructs these API DTOs reflectively, including nested generic response
# types. Keep their shape while allowing renamed classes/fields: every wire
# field has @SerializedName. Do not keep the whole application or library graph.
-keep,allowobfuscation class com.example.madverse.core.network.model.** { *; }
-keepattributes Signature,RuntimeVisibleAnnotations,AnnotationDefault

# The embedded player receives callbacks from JavaScript. Preserve annotated
# bridge methods even though their callers are outside the Java call graph.
-keepclassmembers class com.pierfrancescosoffritti.androidyoutubeplayer.** {
    @android.webkit.JavascriptInterface <methods>;
}
