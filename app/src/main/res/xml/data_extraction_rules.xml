<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude internal Room database files to prevent stale offline sync queues and deletion journal resurrection -->
        <exclude domain="database" path="madverse.db" />
        <exclude domain="database" path="madverse.db-wal" />
        <exclude domain="database" path="madverse.db-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude internal Room database files during device migration; cloud sync restores state for authenticated accounts -->
        <exclude domain="database" path="madverse.db" />
        <exclude domain="database" path="madverse.db-wal" />
        <exclude domain="database" path="madverse.db-shm" />
    </device-transfer>
</data-extraction-rules>
